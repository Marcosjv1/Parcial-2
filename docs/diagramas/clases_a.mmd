classDiagram
direction LR
class HomeScreen {
  -Future~List~DiaryEntry~~ _entriesFuture
  -_reload()
}
class EntryDetailScreen {
  +DiaryEntry entry
  -_confirmAndDelete()
  -_openInGoogleMaps()
}
class DiaryRepository {
  <<interface>>
  +getAll() Future~List~DiaryEntry~~
  +getById(int) Future~DiaryEntry?~
  +insert(DiaryEntry) Future~DiaryEntry~
  +delete(int) Future~void~
}
class SqliteDiaryRepository {
  -DatabaseHelper _dbHelper
}
class DatabaseHelper {
  <<singleton>>
  +instance$ DatabaseHelper
  +database Future~Database~
  -_onCreate(Database, int)
}
class DiaryEntry {
  +int? id
  +String title
  +String content
  +DateTime createdAt
  +String? imagePath
  +GeoPoint? location
  +toMap() Map
  +fromMap(Map)$ DiaryEntry
  +copyWith() DiaryEntry
}
class GeoPoint {
  +double latitude
  +double longitude
}
HomeScreen --> DiaryRepository : usa
EntryDetailScreen --> DiaryRepository : usa
DiaryRepository <|.. SqliteDiaryRepository : implementa
SqliteDiaryRepository --> DatabaseHelper
DiaryRepository ..> DiaryEntry
DiaryEntry *-- GeoPoint
