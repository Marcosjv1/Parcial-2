flowchart TB
  CAM[Cámara / Galería] -- foto --> CS[CamaraService]
  MIC[Micrófono] -- voz --> VS[VozService]
  GPS[GPS] -- posición --> US[UbicacionService]
  CS -- ruta de la foto --> NE[NuevaEntradaScreen]
  VS -- texto --> NE
  US -- latitud y longitud --> NE
  NE -- "insertar(entrada)" --> DB[DBHelper]
  DB <--> SQL[(SQLite<br/>tabla entradas)]
  DB -- "obtenerTodas()" --> IS[InicioScreen<br/>FutureBuilder]
  IS -- "pushNamed('/detalle')" --> DS[DetalleScreen<br/>Hero]
  DS -- coordenadas --> GM[Google Maps]
