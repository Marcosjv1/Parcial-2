sequenceDiagram
  actor U as Usuario
  participant N as NuevaEntradaScreen
  participant C as CamaraService
  participant V as VozService
  participant G as UbicacionService
  participant D as DBHelper
  U->>N: Toca "Cámara"
  N->>C: tomarFoto()
  C-->>N: ruta de la foto
  U->>N: Toca "Dictar con voz" y habla
  N->>V: escuchar()
  V-->>N: texto reconocido
  U->>N: Toca "Guardar"
  N->>G: obtenerUbicacion()
  G-->>N: latitud, longitud
  N->>D: insertar(entrada)
  D-->>N: OK
  N-->>U: Regresa a la lista
