classDiagram
direction TB
class ServiceLocator {
  +production()$ ServiceLocator
}
class NewEntryScreen {
  -_pickImage()
  -_toggleDictation()
  -_save()
}
class MediaService {
  <<interface>>
  +takePhoto() Future~String?~
  +pickFromGallery() Future~String?~
  +deleteImage(String)
}
class SpeechService {
  <<interface>>
  +initialize() Future~bool~
  +startListening(onResult)
  +stopListening()
}
class LocationService {
  <<interface>>
  +getCurrentPosition() Future~GeoPoint~
}
class MapsLauncherService {
  <<interface>>
  +openInMaps(GeoPoint)
}
class ImagePickerMediaService
class SpeechToTextService
class GeolocatorLocationService
class GoogleMapsLauncherService
ServiceLocator o-- MediaService
ServiceLocator o-- SpeechService
ServiceLocator o-- LocationService
ServiceLocator o-- MapsLauncherService
NewEntryScreen --> MediaService
NewEntryScreen --> SpeechService
NewEntryScreen --> LocationService
MediaService <|.. ImagePickerMediaService
SpeechService <|.. SpeechToTextService
LocationService <|.. GeolocatorLocationService
MapsLauncherService <|.. GoogleMapsLauncherService
