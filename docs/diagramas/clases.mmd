classDiagram
direction LR
class MiApp {
  +build() MaterialApp
}
class LoginScreen {
  -_desbloquear()
}
class InicioScreen {
  -Future~List~Reporte~~ _reportes
  -_recargar()
  -_irANuevoReporte()
  -_irADetalle(Reporte)
}
class NuevoReporteScreen {
  -String _tipo
  -String? _imagen
  -bool _escuchando
  -_tomarFoto()
  -_dictar()
  -_guardar()
}
class DetalleScreen {
  -_abrirMapa(Reporte)
  -_cambiarEstado(Reporte)
  -_verJson(Reporte)
  -_eliminar(Reporte)
}
class Reporte {
  +int? id
  +String tipo
  +String descripcion
  +String fecha
  +String estado
  +String? imagen
  +double? latitud
  +double? longitud
  +toMap() Map
  +fromMap(Map)$ Reporte
  +toJson() String
}
class DBHelper {
  +insertar(Reporte)$
  +obtenerTodos()$ List~Reporte~
  +actualizarEstado(int, String)$
  +eliminar(int)$
}
class AuthService {
  +autenticar()$ bool
}
class PermisosService {
  +pedir(context, permiso, nombre)$ bool
}
class CamaraService {
  +tomarFoto()$ String?
  +elegirDeGaleria()$ String?
}
class VozService {
  +iniciar(alTerminar) bool
  +escuchar(alReconocer)
  +detener()
}
class UbicacionService {
  +obtenerUbicacion()$ Position
}
MiApp --> LoginScreen : ruta /
MiApp --> InicioScreen : ruta /inicio
MiApp --> NuevoReporteScreen : ruta /nuevo
MiApp --> DetalleScreen : ruta /detalle
LoginScreen --> AuthService
InicioScreen --> DBHelper
DetalleScreen --> DBHelper
NuevoReporteScreen --> DBHelper
NuevoReporteScreen --> PermisosService
NuevoReporteScreen --> CamaraService
NuevoReporteScreen --> VozService
NuevoReporteScreen --> UbicacionService
DBHelper ..> Reporte
